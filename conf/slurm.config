/*
 * Slurm cluster with Apptainer. The same workflow runs unchanged; only the
 * executor and container engine differ. Adjust the partition names to your site.
 */

params {
    slurm_partition     = 'cpu'
    slurm_gpu_partition = 'gpu'
}

process {
    executor = 'slurm'
    queue    = { task.label?.contains('process_gpu') ? params.slurm_gpu_partition : params.slurm_partition }
    withLabel: process_gpu {
        clusterOptions = '--gres=gpu:1'
    }
}

executor {
    queueSize       = 50
    submitRateLimit = '10 sec'
}

apptainer {
    enabled    = true
    autoMounts = true
}
