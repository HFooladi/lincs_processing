/*
 * Resource labels. Every process picks one; profiles only override these.
 */

process {
    cpus   = 1
    memory = 4.GB
    time   = 2.h

    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: process_single {
        cpus   = 1
        memory = { 8.GB * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 4
        memory = { 16.GB * task.attempt }
    }
    withLabel: process_high_memory {
        cpus   = 4
        memory = { 64.GB * task.attempt }
        time   = 8.h
    }
    withLabel: process_gpu {
        cpus     = 8
        memory   = { 64.GB * task.attempt }
        time     = 12.h
        // Concurrency cap: never more training tasks at once than GPUs.
        maxForks = params.max_gpu_jobs
    }
}
