/*
 * Per-process arguments (built from params) and published outputs.
 * Outputs are published as copies so results/ survives cleaning work/.
 */

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy',
        saveAs: { filename -> filename == 'versions.yml' ? null : filename },
    ]

    withName: 'INGEST' {
        ext.args   = "--pert_type ${params.pert_type}"
        publishDir = [path: { "${params.outdir}/data/raw" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'QC_FILTER' {
        ext.args = [
            "--min_cc_q75 ${params.min_cc_q75}",
            "--min_tas ${params.min_tas}",
            "--min_rep ${params.min_rep}",
            params.min_ss != null ? "--min_ss ${params.min_ss}" : '',
            params.min_dose_um != null ? "--min_dose_um ${params.min_dose_um}" : '',
            params.max_dose_um != null ? "--max_dose_um ${params.max_dose_um}" : '',
            params.times_h ? "--times_h ${params.times_h.toString().tokenize(',').join(' ')}" : '',
        ].join(' ').trim()
        publishDir = [path: { "${params.outdir}/data/filtered" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'MAKE_SPLITS' {
        ext.args   = "--seed ${params.split_seed} --val_frac ${params.val_frac} --test_frac ${params.test_frac}"
        publishDir = [path: { "${params.outdir}/splits" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'TRAIN' {
        ext.args = [
            "--epochs ${params.epochs}",
            "--batch_size ${params.batch_size}",
            "--lr ${params.lr}",
            "--weight_decay ${params.weight_decay}",
            "--patience ${params.patience}",
            "--hidden ${params.hidden}",
            "--layers ${params.layers}",
            "--dropout ${params.dropout}",
            "--batch_correction ${params.batch_correction}",
            "--device ${params.device}",
            "--tracker ${params.tracker}",
            "--experiment ${params.experiment}",
        ].join(' ')
        publishDir = [path: { "${params.outdir}/runs/${split_type}" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'EVALUATE' {
        ext.args   = "--tracker ${params.tracker} --experiment ${params.experiment}"
        publishDir = [path: { "${params.outdir}/runs/${split_type}" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'COLLECT_METRICS' {
        publishDir = [path: { "${params.outdir}/metrics" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'PACKAGE_MODEL' {
        publishDir = [path: { "${params.outdir}" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'REGISTRY_GATE' {
        ext.args = [
            "--split_type ${params.gate_split}",
            "--metric ${params.gate_metric}",
            "--margin ${params.gate_margin}",
            "--model_name ${params.model_name}",
            "--tracker ${params.tracker}",
            "--experiment ${params.experiment}",
            params.gate_strict ? '--strict' : '',
        ].join(' ').trim()
        publishDir = [path: { "${params.outdir}/metrics" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
}
