/*
 * AWS Batch. Push the image to ECR and point --container at it; the work
 * directory must be an S3 path (-work-dir s3://bucket/work).
 */

process {
    executor = 'awsbatch'
    queue    = params.awsbatch_queue
    withLabel: process_gpu {
        accelerator = 1
    }
}

aws {
    region = params.aws_region
    batch {
        cliPath = '/home/ec2-user/miniconda/bin/aws'
    }
}
