/*
 * GPU training. Combine with a container profile, e.g. -profile docker,gpu.
 */

process {
    withLabel: process_gpu {
        accelerator = 1
        containerOptions = { workflow.containerEngine == 'docker' ? '--gpus all' : (workflow.containerEngine in ['apptainer', 'singularity'] ? '--nv' : '') }
    }
}
