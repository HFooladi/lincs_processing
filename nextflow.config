/*
 * LINCS perturbation-prediction workflow: parameters, profiles and defaults.
 */

manifest {
    name            = 'HFooladi/lincs_processing'
    description     = 'LINCS L1000 perturbation-response prediction: ingest, QC, cold splits, training, evaluation, packaging'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.04.0'
    version         = '0.3.0'
    homePage        = 'https://github.com/HFooladi/lincs_processing'
}

plugins {
    id 'nf-schema@2.4.2'
}

params {
    // Ingest: raw files of one release (beta = CLUE 2020, or GEO gse92742/gse70138)
    release     = 'beta'
    gctx        = null
    sig_info    = null
    gene_info   = null
    pert_info   = null
    sig_metrics = null
    drug_info   = null
    pert_type   = 'trt_cp'

    // QC & filter (fixed thresholds, nothing fitted)
    min_cc_q75  = 0.2
    min_tas     = 0.0
    min_ss      = null
    min_rep     = 2
    min_dose_um = null
    max_dose_um = null
    times_h     = null

    // Split
    splits      = 'cold_compound,cold_cell,cold_both'
    split_seed  = 0
    val_frac    = 0.1
    test_frac   = 0.2

    // Fit & train: one task per (split, seed)
    seeds            = '0,1,2'
    epochs           = 50
    batch_size       = 512
    lr               = 0.001
    weight_decay     = 0.0001
    patience         = 5
    hidden           = 1024
    layers           = 2
    dropout          = 0.2
    batch_correction = 'cell_center'
    cell_features    = null
    device           = 'auto'

    // Tracking and registry gate
    tracker      = 'mlflow'
    experiment   = 'lincs-perturbation'
    mlflow_dir   = "${launchDir}/mlflow"
    mlflow_uri   = null
    model_name   = 'lincs-perturbation'
    gate_split   = 'cold_cell'
    gate_metric  = 'pearson_mean'
    gate_margin  = 0.0
    gate_strict  = false

    // Infrastructure
    outdir        = 'results'
    container     = 'lincs-processing:0.3.0'
    max_gpu_jobs  = 3
    max_cpus      = 16
    max_memory    = '128.GB'
    awsbatch_queue = null
    aws_region    = 'eu-west-1'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// Tracking location reaches tasks through the environment, not task inputs,
// so pointing runs at another MLflow server never invalidates -resume.
env {
    MLFLOW_TRACKING_URI    = params.mlflow_uri ?: "sqlite:///${params.mlflow_dir}/mlflow.db"
    LINCS_MLFLOW_ARTIFACTS = "${params.mlflow_dir}/artifacts"
    LINCS_CONTAINER        = params.container
    PYTHONWARNINGS         = 'ignore::FutureWarning'
}

profiles {
    // Run tasks with the project's uv environment (`uv sync --group pipeline`).
    venv {
        env.PATH = "${projectDir}/.venv/bin:\$PATH"
    }
    docker {
        docker.enabled    = true
        process.container = params.container
        // Run as the calling user and mount the MLflow store into every task.
        docker.runOptions = "-u \$(id -u):\$(id -g) -e HOME=/tmp -v ${params.mlflow_dir}:${params.mlflow_dir}"
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        process.container    = "docker-daemon://${params.container}"
    }
    gpu      { includeConfig 'conf/gpu.config' }
    slurm    { includeConfig 'conf/slurm.config' }
    awsbatch { includeConfig 'conf/awsbatch.config' }
    test     { includeConfig 'conf/test.config' }
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.tsv"
    overwrite = true
}
